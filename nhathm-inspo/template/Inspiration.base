filters:
  and:
    - file.inFolder("Inspiration/notes")
properties:
  note.category:
    displayName: Category
  note.status:
    displayName: Status
  note.type:
    displayName: Type
  note.review:
    displayName: Review
  note.captured_by:
    displayName: Người lưu
views:
  - type: table
    name: Đang mở
    filters:
      or:
        - note.status == "inbox"
        - note.status == "later"
    order:
      - file.name
      - category
      - status
      - type
      - effort
      - related
      - review
    sort:
      - property: review
        direction: ASC
  - type: table
    name: Đến hạn review
    filters:
      and:
        - note.review <= today()
        - note.status == "inbox"
    order:
      - file.name
      - status
      - review
  - type: cards
    name: Gallery
    order:
      - file.name
      - type
  - type: table
    name: Tất cả
    order:
      - file.name
      - category
      - status
      - captured_by
      - type
      - captured
